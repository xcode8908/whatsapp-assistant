# ===============================================
# 🤖 WHATSAPP AI ASSISTANT & TELEGRAM CONTROLLER
# ===============================================

# 1. Telegram Settings (@BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Search @userinfobot on Telegram to get your numeric ID
TELEGRAM_ADMIN_ID=your_telegram_chat_id_here

# 2. Gemini AI Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. WAHA Settings (Defaults to local NOWEB inside container)
WAHA_URL=http://localhost:3000
WAHA_SESSION=default

# 4. Database (Optional for Render/Supabase)
# Agar Supabase use kar rahe hain toh PostgreSQL URI dalein:
# DATABASE_URL=postgresql://postgres:password@db.xxxxxx.supabase.co:5432/postgres
# Agar blank chodenge toh local SQLite database use hoga:
DATABASE_URL=

# 5. Server Port (Render sets this automatically)
PORT=10000
